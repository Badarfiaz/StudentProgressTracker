rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the super admin, and only with a verified email, can delete.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'badars20plus@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /settings/{doc} {
      allow read, write: if true;
    }
    match /students/{regId}/records/{recordId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if request.resource.data.regId == regId
        && request.resource.data.subjectKey is string
        && request.resource.data.examDateISO is string;
    }
  }
}
